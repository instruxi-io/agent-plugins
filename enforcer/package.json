{
  "name": "@instruxi-io/enforcer",
  "license": "FSL-1.1-ALv2",
  "version": "1.6.0",
  "bin": {
    "enforcer": "bin/enforcer"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "hooks",
    "skills",
    "agents",
    "commands",
    "harness",
    "plugin.json",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "mcp.json",
    ".mcp.json",
    "docs/graph",
    "README.md",
    "LICENSE",
    "!**/test/**",
    "!**/fixtures/**",
    "!**/.github/**"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "scripts": {
    "pretest": "node test/ensure-deps.mjs",
    "posttest": "node test/tmp-posttest.mjs",
    "test": "node scripts/test.mjs",
    "sync:spec": "node lib/api/sync-spec.mjs",
    "gen:api": "node lib/api/gen.mjs",
    "lint": "node scripts/biome.mjs lint",
    "format:check": "node scripts/biome.mjs format",
    "format": "node scripts/biome.mjs format --write",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
